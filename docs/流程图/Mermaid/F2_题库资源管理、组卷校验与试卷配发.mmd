flowchart TB
  %% F2 题库资源管理、组卷校验与试卷配发
  %% 实线：业务衔接；虚线：待确认路径；角色分组不等同于固定岗位或已确认权限。
  subgraph F2_LANE_0["题库管理人员"]
    direction TB
    %% F2-S1 职责／图形：开始／来源
    %% 说明及输入输出：【编排】资源建设入口，与考试组卷入口分开
    F2_S1(["F2-S1<br/>接收题库开发成果、既有资源或公开资源<br/>职责：开始／来源<br/>依据：2.1.14、2.2.5、2.4.1"])
    %% F2-01 职责／图形：人工／题库管理
    %% 说明及输入输出：母库、子库、通用库；理论与技能管理分类
    F2_01["F2-01<br/>维护理论与技能题库分类及科目体系<br/>职责：人工／题库管理<br/>依据：2.2概述、2.2.3"]
    %% F2-02 职责／图形：人工／题库管理
    %% 说明及输入输出：支持新增、修改、删除及实时维护；操作权限和历史引用处理待确认
    F2_02["F2-02<br/>维护知识结构、比重表、试题及考评标准<br/>职责：人工／题库管理<br/>依据：2.2.3—4、2.2.19"]
    %% F2-04 职责／图形：人工／题库管理
    %% 说明及输入输出：输入既有试题文件；模板及支持的具体格式清单待确认
    F2_04["F2-04<br/>按Excel或Word等模板导入试题内容<br/>职责：人工／题库管理<br/>依据：2.2.5"]
    %% F2-06 职责／图形：人工／资源提供者或管理人员
    %% 说明及输入输出：【编排】失败返回路径，不新增导入审批
    F2_06["F2-06<br/>修正不合规内容并重新导入<br/>职责：人工／资源提供者或管理人员<br/>依据：2.2.5"]
    %% F2-09 职责／图形：人工／题库管理
    %% 说明及输入输出：技能题另支持转移和批量操作；不得扩大为所有资源均可任意跨机构转移
    F2_09["F2-09<br/>检索查看并动态维护题库资源<br/>职责：人工／题库管理<br/>依据：2.2概述、2.2.12、2.2.19"]
    %% F2-11 职责／图形：人工／组卷专家
    %% 说明及输入输出：明确每题题型、分值、难度，形成专家自定义试卷
    F2_11["F2-11<br/>精准检索并手动选择试题<br/>职责：人工／组卷专家<br/>依据：2.2.6、2.2.8"]
  end
  subgraph F2_LANE_1["组卷专家／组卷人员"]
    direction TB
    %% F2-10 职责／图形：人工／组卷人员
    %% 说明及输入输出：确定科目、知识点比重、题型、分值、难度及所需试卷；不预设统一题量分值
    F2_10["F2-10<br/>配置标准化组卷规则<br/>职责：人工／组卷人员<br/>依据：2.2.6—8"]
    %% F2-D2 职责／图形：判断／组卷人员
    %% 说明及输入输出：【编排】两种模式均须保留
    F2_D2{"F2-D2<br/>采用固定组卷还是随机组卷？<br/>职责：判断／组卷人员<br/>依据：2.2.6"}
    %% F2-14 职责／图形：人工／组卷人员及系统
    %% 说明及输入输出：支持母库＋子库＋通用库；AB卷自动控制重复率；适用组合关系待确认，不默认每次全选
    F2_14["F2-14<br/>应用跨科目、1+X+Y及AB卷组卷配置<br/>职责：人工／组卷人员及系统<br/>依据：2.2.8"]
    %% F2-17 职责／图形：人工／组卷人员
    %% 说明及输入输出：【待确认路径】调整规则、选题或补充资源后重组；不得自动放宽标准
    F2_17["F2-17<br/>处理校验不符合情况<br/>职责：人工／组卷人员<br/>依据：2.2.6—9、2.2.15"]
  end
  subgraph F2_LANE_2["考务／试卷配发人员"]
    direction TB
    %% F2-S2 职责／图形：开始／考务及组卷人员
    %% 说明及输入输出：【编排】已有题库可直接参与组卷；对接原考务计划
    F2_S2(["F2-S2<br/>接收考试计划与组卷需求<br/>职责：开始／考务及组卷人员<br/>依据：2.2.9、2.4.4"])
    %% F2-12 职责／图形：人工／组卷人员
    %% 说明及输入输出：知识点覆盖度、题型分布、难度分布及知识点比重
    F2_12["F2-12<br/>配置随机抽题的覆盖度与分布要求<br/>职责：人工／组卷人员<br/>依据：2.2.7—8"]
    %% F2-19 职责／图形：人工／配发人员
    %% 说明及输入输出：尤其包含技能题库子系统的批次配发；接收机构与具体操作主体待确认
    F2_19["F2-19<br/>按批次、职业工种和等级配发试卷<br/>职责：人工／配发人员<br/>依据：2.2.12、2.4.5"]
    %% F2-D4 职责／图形：判断／配发人员
    %% 说明及输入输出：【编排】考试形式与理论／技能分类不能混为一个判断
    F2_D4{"F2-D4<br/>配发至机考还是传统考试？<br/>职责：判断／配发人员<br/>依据：2.2.12、2.4.5"}
    %% F2-21 职责／图形：人工／传统考试接收方
    %% 说明及输入输出：理论纸笔考试不自动进入F5技能评分流程；纸笔答卷如何录入或阅卷待确认
    F2_21["F2-21<br/>下载打印试卷并用于现场考试<br/>职责：人工／传统考试接收方<br/>依据：2.4.5"]
    %% F2-E 职责／图形：结束／跨图
    %% 说明及输入输出：【编排】使用情况持续回到F2-22／F2-23
    F2_E(["F2-E<br/>试卷配发并进入考试或技能考核<br/>职责：结束／跨图<br/>依据：2.2.10、2.4.5"])
  end
  subgraph F2_LANE_3["获授权监管人员"]
    direction TB
    %% F2-22 职责／图形：人工／获授权监管人员
    %% 说明及输入输出：追溯监管试卷应用过程；可见范围和下载权限待确认
    F2_22["F2-22<br/>查看下载题库抽取情况及机构最终试卷<br/>职责：人工／获授权监管人员<br/>依据：2.2.10—12"]
  end
  subgraph F2_LANE_4["系统自动处理"]
    direction TB
    %% F2-03 职责／图形：系统
    %% 说明及输入输出：理论结构为工种→等级→科目→知识点；每题唯一标识并对应知识点；技能按工种等级组织
    F2_03["F2-03<br/>按工种、等级及知识结构组织试题<br/>职责：系统<br/>依据：2.2.4、2.2.16"]
    %% F2-05 职责／图形：系统
    %% 说明及输入输出：输出校验结果；协议明确格式校验，不自动等同于专家内容审核
    F2_05["F2-05<br/>自动校验导入格式合规性<br/>职责：系统<br/>依据：2.2.5"]
    %% F2-D1 职责／图形：判断／系统
    %% 说明及输入输出：【编排】合规／不合规；错误提示、部分成功或整批处理口径待确认
    F2_D1{"F2-D1<br/>导入格式是否合规？<br/>职责：判断／系统<br/>依据：2.2.5"}
    %% F2-08 职责／图形：系统／获授权人员
    %% 说明及输入输出：汇合F1成果、格式合规资源和公开资源；导入／交换资源的审核入库衔接待确认
    F2_08["F2-08<br/>将资源纳入题库管理<br/>职责：系统／获授权人员<br/>依据：2.1.3、2.2.5、2.4.1"]
    %% F2-13 职责／图形：系统
    %% 说明及输入输出：支持多套试卷，不能固定为只生成一套或AB两套
    F2_13["F2-13<br/>按规则与比重自动抽题生成试卷<br/>职责：系统<br/>依据：2.2.7、2.2.15"]
    %% F2-15 职责／图形：系统
    %% 说明及输入输出：与F3考试呈现的乱序机制衔接；不由此新增逐考生不同卷规则
    F2_15["F2-15<br/>按配置打乱试题及选项顺序<br/>职责：系统<br/>依据：2.2.8、2.3.11"]
    %% F2-16 职责／图形：系统
    %% 说明及输入输出：包含规定的组卷质量与规则校验；具体阈值、报告表现形式待确认
    F2_16["F2-16<br/>校验试卷重复率及组卷规则符合性<br/>职责：系统<br/>依据：2.2.9、2.2.15"]
    %% F2-D3 职责／图形：判断／系统
    %% 说明及输入输出：【编排】符合／不符合；必须明确不能将不满足规则标为校验通过
    F2_D3{"F2-D3<br/>试卷是否符合组卷规则？<br/>职责：判断／系统<br/>依据：2.2.15"}
    %% F2-18 职责／图形：系统
    %% 说明及输入输出：这是明确要求；协议未另行要求“冻结审批”节点
    F2_18["F2-18<br/>按计划存储生成试卷供后续配发<br/>职责：系统<br/>依据：2.2.9"]
    %% F2-20 职责／图形：系统／配发人员
    %% 说明及输入输出：对接F3理论机考；协议未规定所有技能考试采用在线作答
    F2_20["F2-20<br/>配卷后推送机考使用<br/>职责：系统／配发人员<br/>依据：2.3.1、2.4.5"]
    %% F2-23 职责／图形：系统／管理人员
    %% 说明及输入输出：多维分析统计，支持业务管理
    F2_23["F2-23<br/>统计分析题库、组卷及试卷应用数据<br/>职责：系统／管理人员<br/>依据：2.2.13、2.4.8"]
  end
  subgraph F2_LANE_5["外部／关联系统"]
    direction TB
    %% F2-07 职责／图形：交接／外部系统
    %% 说明及输入输出：与人社部题库开发、题库管理等业务系统对接，交互共享，支持一次录入、多方共用
    F2_07["F2-07<br/>交换人社部已有公开题库资源<br/>职责：交接／外部系统<br/>依据：主要指标5、2.4.1"]
  end
