    F1_23(["F1-23<br/>发起已入库试题修订并重新审核"])
    F1_E(["F1-E<br/>试题入库完成并供题库管理使用"])
    F2_R人社部(["F2-R人社部<br/>外部系统／数据来源"])
    F3_05(["F3-05<br/>一键配卷并推送考试"])
    F5_06(["F5-06<br/>按批次、工种及等级配发技能试卷"])
  end
