flowchart TB
  %% F3 无纸化理论考试组织、核验、作答与交卷
  %% 实线：业务衔接；虚线：待确认路径；角色分组不等同于固定岗位或已确认权限。
  subgraph F3_LANE_0["HR／原考务及关联业务"]
    direction TB
    %% F3-01 职责／图形：系统／HR
    %% 说明及输入输出：姓名、身份证号、工种代码、当前技能等级等，确保自动同步及一致
    F3_01["F3-01<br/>映射并同步员工与考生身份信息<br/>职责：系统／HR<br/>依据：2.4.3"]
    %% F3-03 职责／图形：系统／关联业务
    %% 说明及输入输出：连接F1及F2；是否每次触发、如何使用既有资源待确认，不强制所有考试重新命题
    F3_03["F3-03<br/>按考务计划联动生成对应试题任务<br/>职责：系统／关联业务<br/>依据：2.4.4"]
  end
  subgraph F3_LANE_1["考试管理人员"]
    direction TB
    %% F3-S 职责／图形：开始
    %% 说明及输入输出：【编排】输入认定业务及考试安排
    F3_S(["F3-S<br/>接收考试组织需求<br/>职责：开始<br/>依据：2.3概述、2.4.4"])
    %% F3-02 职责／图形：管理人员／原考务及系统
    %% 说明及输入输出：一键形成计划、灵活分配考点考场与原考务联动并存；主责系统待确认
    F3_02["F3-02<br/>形成或衔接考试计划、考点考场及监考安排<br/>职责：管理人员／原考务及系统<br/>依据：2.3概述、2.4.4"]
    %% F3-04 职责／图形：人工／考试管理
    %% 说明及输入输出：包含时间规则、IP范围、考中人脸识别间隔；其他可配置项以条款能力为边界
    F3_04["F3-04<br/>配置考试时间、访问及安全参数<br/>职责：人工／考试管理<br/>依据：2.3.6—11"]
    %% F3-05 职责／图形：人工／考试管理及系统
    %% 说明及输入输出：输入F2试卷和场次安排；输出可供考生参加的考试
    F3_05["F3-05<br/>一键配卷并推送考试<br/>职责：人工／考试管理及系统<br/>依据：2.3.1、2.4.5"]
  end
  subgraph F3_LANE_2["考生"]
    direction TB
    %% F3-06 职责／图形：人工／考生
    %% 说明及输入输出：手机应保证本人作答；出差人员可按实际安排与本地人员同时考试，不新增远程监考平台
    F3_06["F3-06<br/>使用PC、平板或手机进入对应考试<br/>职责：人工／考生<br/>依据：2.3.3、2.3.6"]
    %% F3-11 职责／图形：人工／考生
    %% 说明及输入输出：字号自主调整、计算器、试题标记；PC、手机等终端按要求适配
    F3_11["F3-11<br/>在线作答并使用考试辅助工具<br/>职责：人工／考生<br/>依据：2.3.3、2.3.12"]
    %% F3-15 职责／图形：人工／考生
    %% 说明及输入输出：【编排】主动提交入口
    F3_15["F3-15<br/>发起交卷<br/>职责：人工／考生<br/>依据：2.3.9、2.3.12"]
    %% F3-16 职责／图形：人工／考生及系统
    %% 说明及输入输出：确认次数、签字形式待确认；不能以一次按钮点击替代多次确认要求
    F3_16["F3-16<br/>多次确认交卷并完成考生签字确认<br/>职责：人工／考生及系统<br/>依据：2.3.12"]
    %% F3-19 职责／图形：系统／考生
    %% 说明及输入输出：含题型、知识结构得分分布和知识掌握情况；与F4人工阅卷完成时点衔接
    F3_19["F3-19<br/>提供可获取的成绩及个人分析报告<br/>职责：系统／考生<br/>依据：2.3.5、2.3.13"]
  end
  subgraph F3_LANE_3["系统／受控考试环境"]
    direction TB
    %% F3-D1 职责／图形：判断／系统
    %% 说明及输入输出：【编排】通过／未通过，未通过不自动赋予人工放行权限
    F3_D1{"F3-D1<br/>考生身份核验是否满足要求？<br/>职责：判断／系统<br/>依据：2.3.6"}
    %% F3-08 职责／图形：系统
    %% 说明及输入输出：仅允许指定IP范围内人员作答；迟到超过30分钟禁止作答
    F3_08["F3-08<br/>检查IP范围及入场时间<br/>职责：系统<br/>依据：2.3.7、2.3.9"]
    %% F3-D2 职责／图形：判断／系统
    %% 说明及输入输出：【编排】两个判断可拆开绘制；计时起点及时间基准待确认
    F3_D2{"F3-D2<br/>是否位于允许IP范围且未迟到超过30分钟？<br/>职责：判断／系统<br/>依据：2.3.7、2.3.9"}
    %% F3-09 职责／图形：系统
    %% 说明及输入输出：支持机位自动绑定、题序及选项乱序、禁止复制试卷内容
    F3_09["F3-09<br/>绑定机位并应用题目与选项呈现规则<br/>职责：系统<br/>依据：2.3.11"]
    %% F3-10 职责／图形：系统／受控考试环境
    %% 说明及输入输出：详见本图“持续控制带”，这些要求不能遗漏为一个笼统“防作弊”标签
    F3_10["F3-10<br/>启用考试环境与防舞弊控制<br/>职责：系统／受控考试环境<br/>依据：2.3.2、2.3.8、2.3.10—11"]
    %% F3-12 职责／图形：系统
    %% 说明及输入输出：自动保存时机、频率及本地／服务端机制属实现细节，协议未给出固定数值
    F3_12["F3-12<br/>保留作答结果并显示考试倒计时<br/>职责：系统<br/>依据：2.3.4、2.3.12"]
    %% F3-14 职责／图形：系统／考生
    %% 说明及输入输出：手机同步支持；剩余时间、机位变化、恢复次数规则待确认
    F3_14["F3-14<br/>恢复已保留作答并断点续考<br/>职责：系统／考生<br/>依据：2.3.4"]
    %% F3-D4 职责／图形：判断／系统
    %% 说明及输入输出：开考15分钟内禁止交卷；时点边界按条款解释确认，不以Demo按钮替代真实时间
    F3_D4{"F3-D4<br/>是否已满足提前交卷时间条件？<br/>职责：判断／系统<br/>依据：2.3.9"}
    %% F3-17 职责／图形：系统
    %% 说明及输入输出：输出逐题作答、相关考试记录及可供判分的数据，交给F4
    F3_17["F3-17<br/>接收交卷结果并交接判分数据<br/>职责：系统<br/>依据：2.3.5、2.3.20"]
    %% F3-E 职责／图形：结束／跨图
    %% 说明及输入输出：【编排】报告、归档和成绩回传结果在F4统一衔接，避免重复执行
    F3_E(["F3-E<br/>本次作答结束，转入核分、报告与归档<br/>职责：结束／跨图<br/>依据：2.3.5、2.3.13、2.3.20、2.4.6"])
  end
  subgraph F3_LANE_4["身份核验服务"]
    direction TB
    %% F3-07 职责／图形：系统／考生及核验服务
    %% 说明及输入输出：手机同步支持；可接入公安身份验证接口；失败处理方式待确认
    F3_07["F3-07<br/>采集人脸并完成考前身份核验<br/>职责：系统／考生及核验服务<br/>依据：2.3.2、2.3.6"]
    %% F3-13 职责／图形：系统／身份核验服务
    %% 说明及输入输出：与作答并行，不画为考生每答一题都要通过的流程
    F3_13["F3-13<br/>按设定间隔开展考中人脸识别<br/>职责：系统／身份核验服务<br/>依据：2.3.6"]
    %% F3-18 职责／图形：系统／核验服务
    %% 说明及输入输出：【明确能力、待确认时点】并非协议已规定必须在“交卷前”或“查分前”执行
    F3_18["F3-18<br/>支持考后人脸识别<br/>职责：系统／核验服务<br/>依据：2.3.6"]
  end
  subgraph F3_LANE_5["异常处置责任方"]
    direction TB
    %% F3-X2 职责／图形：事件／系统及异常责任人员
    %% 说明及输入输出：技术阻止与事件检测有协议依据；告警、违规次数、人工裁定或处罚路径待确认
    F3_X2["F3-X2<br/>检测或阻止违反考试环境要求的行为<br/>职责：事件／系统及异常责任人员<br/>依据：2.3.2、2.3.10—11"]
    %% F3-X1 职责／图形：事件／异常责任人员及系统
    %% 说明及输入输出：保留已产生的作答结果；不自行增加延时、强制交卷、换机审批等操作权限
    F3_X1["F3-X1<br/>断电、断网或机器损坏，启动应急预案<br/>职责：事件／异常责任人员及系统<br/>依据：2.3.4"]
    %% F3-D3 职责／图形：判断／责任人员及系统
    %% 说明及输入输出：【编排】恢复条件和判断人员待确认
    F3_D3{"F3-D3<br/>异常是否解除并具备恢复条件？<br/>职责：判断／责任人员及系统<br/>依据：2.3.4"}
  end
  subgraph F3_LINKS["跨流程交接／协议未明确的路径出口"]
    F1_S(["F1-S<br/>接到题库开发或修订需求"])
    F2_20(["F2-20<br/>配卷后推送机考使用"])
    F3_R到时交卷(["F3-R到时交卷<br/>处理方式或返回节点待确认"])
    F3_R应急(["F3-R应急<br/>处理方式或返回节点待确认"])
    F3_R核验失败(["F3-R核验失败<br/>处理方式或返回节点待确认"])
    F3_R禁止作答(["F3-R禁止作答<br/>禁止本次进入作答"])
    F3_R违规处置(["F3-R违规处置<br/>处理方式或返回节点待确认"])
    F4_20(["F4-20<br/>形成并提供个人成绩与分析报告"])
    F4_S(["F4-S<br/>接收考试作答、评分标准及考试关联信息"])
  end
