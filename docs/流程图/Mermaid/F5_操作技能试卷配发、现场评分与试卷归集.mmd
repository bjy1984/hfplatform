flowchart TB
  %% F5 操作技能试卷配发、现场评分与试卷归集
  %% 实线：业务衔接；虚线：待确认路径；角色分组不等同于固定岗位或已确认权限。
  subgraph F5_LANE_0["技能题库／抽题人员"]
    direction TB
    %% F5-01 职责／图形：人工／题库管理
    %% 说明及输入输出：接收F1／F2管理的技能资源，支持具体试题查看
    F5_01["F5-01<br/>按工种与等级检索技能试题<br/>职责：人工／题库管理<br/>依据：2.2.12、2.2.16"]
    %% F5-02 职责／图形：人工／题库管理
    %% 说明及输入输出：包含考生准备、考场准备、考核过程要求、考核结果要求和评分标准表
    F5_02["F5-02<br/>查看试题正文、准备要求及评分标准<br/>职责：人工／题库管理<br/>依据：2.2.11、2.2.16"]
    %% F5-D1 职责／图形：判断／抽题人员
    %% 说明及输入输出：【编排】两种技能抽题能力
    F5_D1{"F5-D1<br/>按模块指定抽题还是随机抽题？<br/>职责：判断／抽题人员<br/>依据：2.2.11"}
    %% F5-03 职责／图形：人工／抽题人员
    %% 说明及输入输出：明确模块及所选试题；模块定义待确认，不自动等同于理论知识点
    F5_03["F5-03<br/>按模块指定技能试题<br/>职责：人工／抽题人员<br/>依据：2.2.11"]
  end
  subgraph F5_LANE_1["考试管理／配发人员"]
    direction TB
    %% F5-S 职责／图形：开始
    %% 说明及输入输出：【编排】明确对应工种、等级及批次，衔接考务安排
    F5_S(["F5-S<br/>接收技能考核批次及试卷需求<br/>职责：开始<br/>依据：2.2.12、2.4.4"])
    %% F5-06 职责／图形：人工／配发人员
    %% 说明及输入输出：可作为机考或传统考试内容；具体使用形式及对象待确认
    F5_06["F5-06<br/>按批次、工种及等级配发技能试卷<br/>职责：人工／配发人员<br/>依据：2.2.12、2.4.5"]
    %% F5-09 职责／图形：人工／考试管理或其他人员，归属待确认
    %% 说明及输入输出：【编排】现场评分所需对象关系；具体分配方式、是否评分组待确认，不预设多评委规则
    F5_09["F5-09<br/>关联评分人员、考生及适用评分表<br/>职责：人工／考试管理或其他人员，归属待确认<br/>依据：2.2.11"]
    %% F5-13 职责／图形：人工／获授权管理人员
    %% 说明及输入输出：与F2试卷使用记录关联，按权限查看相关过程
    F5_13["F5-13<br/>追溯和监管技能试卷应用过程<br/>职责：人工／获授权管理人员<br/>依据：2.2.10—11"]
  end
  subgraph F5_LANE_2["考点准备人员"]
    direction TB
    %% F5-07 职责／图形：人工／考点准备人员
    %% 说明及输入输出：【业务衔接】通过技能试题辅助提前准备考场；不新增线上验收审批
    F5_07["F5-07<br/>依据考场准备要求准备场地与设施条件<br/>职责：人工／考点准备人员<br/>依据：2.2.16"]
  end
  subgraph F5_LANE_3["考生"]
    direction TB
    %% F5-08 职责／图形：人工／考生
    %% 说明及输入输出：【业务衔接】试题包含考生准备内容；发放渠道与本人可见材料待确认
    F5_08["F5-08<br/>依据考生准备要求进行考前准备<br/>职责：人工／考生<br/>依据：2.2.11"]
    %% F5-10 职责／图形：人工／考生
    %% 说明及输入输出：【现场业务】不是新增软件审批节点
    F5_10["F5-10<br/>按考核过程及结果要求完成实际操作<br/>职责：人工／考生<br/>依据：2.2.11、2.2.16"]
  end
  subgraph F5_LANE_4["现场技能评分人员"]
    direction TB
    %% F5-11 职责／图形：人工／现场评分人员
    %% 说明及输入输出：输入实际操作表现和评分标准表，记录环节评分
    F5_11["F5-11<br/>使用移动端按现场各环节评分<br/>职责：人工／现场评分人员<br/>依据：2.2.11"]
  end
  subgraph F5_LANE_5["系统自动处理"]
    direction TB
    %% F5-04 职责／图形：系统／抽题人员
    %% 说明及输入输出：输出所抽试题；抽题规则与F2相关配置衔接
    F5_04["F5-04<br/>按模块随机抽取技能试题<br/>职责：系统／抽题人员<br/>依据：2.2.11"]
    %% F5-05 职责／图形：系统／管理人员
    %% 说明及输入输出：引用F2的规则校验与存储结果，不重复创建另一个不一致的试卷
    F5_05["F5-05<br/>形成技能考核试卷并进行适用组卷校验<br/>职责：系统／管理人员<br/>依据：2.2.9、2.2.15"]
    %% F5-12 职责／图形：系统
    %% 说明及输入输出：协议明确自动汇总；缺项、权重、多人评分、扣分或否决规则待确认
    F5_12["F5-12<br/>汇集各环节评分并自动生成技能总分<br/>职责：系统<br/>依据：2.2.11"]
    %% F5-14 职责／图形：系统／管理人员
    %% 说明及输入输出：纳入题库应用、考核、评分多维统计
    F5_14["F5-14<br/>统计分析技能考核与评分数据<br/>职责：系统／管理人员<br/>依据：2.2.13、2.4.8"]
    %% F5-15 职责／图形：系统／获授权人员
    %% 说明及输入输出：输入线上、线下相关试卷，自动合成完整试卷；线下材料获取方式待确认
    F5_15["F5-15<br/>按同一考生整合线上与线下考试试卷<br/>职责：系统／获授权人员<br/>依据：2.2.20"]
    %% F5-E 职责／图形：结束
    %% 说明及输入输出：【编排】归集及接口条件满足后完成对应分支，不规定未提供的成绩审批
    F5_E(["F5-E<br/>技能评分结果形成，试卷与过程可追溯<br/>职责：结束<br/>依据：2.2.11、2.2.20、2.4.6"])
  end
  subgraph F5_LANE_6["集团认定／归集使用者"]
    direction TB
    %% F5-17 职责／图形：系统／集团认定系统
    %% 说明及输入输出：2.4.6规定考试结果自动回传；技能成绩字段、理论技能合成方式及主责系统待确认
    F5_17["F5-17<br/>按确认的成绩接口衔接技能考核结果<br/>职责：系统／集团认定系统<br/>依据：2.4.6—7"]
    %% F5-16 职责／图形：系统／获授权人员
    %% 说明及输入输出：输出同一考生完整试卷及关联关系
    F5_16["F5-16<br/>统一管理并追溯考生完整考核试卷<br/>职责：系统／获授权人员<br/>依据：2.2.20"]
  end
  subgraph F5_LINKS["跨流程交接／协议未明确的路径出口"]
    F1_E(["F1-E<br/>试题入库完成并供题库管理使用"])
    F2_17(["F2-17<br/>处理校验不符合情况"])
    F2_19(["F2-19<br/>按批次、职业工种和等级配发试卷"])
    F5_R线上线下试卷(["F5-R线上线下试卷<br/>外部系统／数据来源"])
    F5_R评分异常(["F5-R评分异常<br/>处理方式或返回节点待确认"])
  end
