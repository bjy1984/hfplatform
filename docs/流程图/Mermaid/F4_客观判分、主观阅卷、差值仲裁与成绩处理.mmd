flowchart TB
  %% F4 客观判分、主观阅卷、差值仲裁与成绩处理
  %% 实线：业务衔接；虚线：待确认路径；角色分组不等同于固定岗位或已确认权限。
  subgraph F4_LANE_0["系统自动处理"]
    direction TB
    %% F4-S 职责／图形：开始／来源
    %% 说明及输入输出：来自F3；包含逐题作答、题目分值、适用答案或评分标准和考生关联信息
    F4_S(["F4-S<br/>接收考试作答、评分标准及考试关联信息<br/>职责：开始／来源<br/>依据：2.3.5、2.3.14—17"])
    %% F4-01 职责／图形：系统
    %% 说明及输入输出：输入客观题作答与答案、计分规则；形成客观题分数
    F4_01["F4-01<br/>对客观题自动判分并形成成绩<br/>职责：系统<br/>依据：2.3概述、2.3.5"]
    %% F4-D1 职责／图形：判断／系统
    %% 说明及输入输出：【编排】是→人工阅卷支线；否→结果形成，不强制分配阅卷专家
    F4_D1{"F4-D1<br/>是否存在需要人工评阅的主观题？<br/>职责：判断／系统<br/>依据：2.3.5"}
    %% F4-08 职责／图形：系统
    %% 说明及输入输出：按配置的试题／考生／试卷维度呈现；选用保密阅卷时屏蔽考生身份
    F4_08["F4-08<br/>向分配的专家提供评阅内容<br/>职责：系统<br/>依据：2.3.16—17"]
    %% F4-10 职责／图形：系统／评分人员
    %% 说明及输入输出：明确保留该能力；开放哪些结果、何时开放，不等于自动开放其他专家评分
    F4_10["F4-10<br/>开放系统智能判分结果供评分人员查看<br/>职责：系统／评分人员<br/>依据：2.3.19"]
    %% F4-D2 职责／图形：判断／系统
    %% 说明及输入输出：【编排】包括已配置评阅数量等；协议未给出所有组合条件
    F4_D2{"F4-D2<br/>是否满足当前判分方式的核分条件？<br/>职责：判断／系统<br/>依据：2.3.5、2.3.15、2.3.17"}
    %% F4-12 职责／图形：系统
    %% 说明及输入输出：差值计算口径与多人评分比较方法待确认
    F4_12["F4-12<br/>汇集评分并检查评分差值<br/>职责：系统<br/>依据：2.3.14"]
    %% F4-D3 职责／图形：判断／系统
    %% 说明及输入输出：条款明确“超出阈值时触发”；不额外设置未规定的二次审批阈值
    F4_D3{"F4-D3<br/>评分差值是否超出适用阈值？<br/>职责：判断／系统<br/>依据：2.3.14"}
    %% F4-13 职责／图形：系统
    %% 说明及输入输出：正常核分分支；规则变化是否影响已判结果待确认
    F4_13["F4-13<br/>按配置的权重、平均或去极值等规则核分<br/>职责：系统<br/>依据：2.3.15"]
    %% F4-14 职责／图形：系统
    %% 说明及输入输出：对接按试题配置的人员及人数
    F4_14["F4-14<br/>触发仲裁流程并关联指定仲裁人员<br/>职责：系统<br/>依据：2.3.14"]
    %% F4-18 职责／图形：系统
    %% 说明及输入输出：汇集客观题分数、主观核分结果及总成绩；总成绩构成和精度依确认规则
    F4_18["F4-18<br/>形成主观核分结果并汇总考试成绩<br/>职责：系统<br/>依据：2.3.5、2.4.6"]
    %% F4-19 职责／图形：系统
    %% 说明及输入输出：以考生答题数据开展智能分析；具体经典测量学指标、口径和样本条件待确认
    F4_19["F4-19<br/>分析考生能力分布与试卷质量<br/>职责：系统<br/>依据：主要指标2—3、2.3.5"]
    %% F4-E 职责／图形：结束
    %% 说明及输入输出：【编排】各输出分支可并行，不强制报告下载后才能回传
    F4_E(["F4-E<br/>成绩、报告、归档及回传按确认规则完成<br/>职责：结束<br/>依据：2.3.13、2.3.20、2.4.6"])
  end
  subgraph F4_LANE_1["阅卷组织管理人员"]
    direction TB
    %% F4-02 职责／图形：人工／阅卷管理
    %% 说明及输入输出：评分专家集中管理及任务组织；是否复用命审专家库、资格条件待确认
    F4_02["F4-02<br/>组织评分专家资源<br/>职责：人工／阅卷管理<br/>依据：2.3概述、2.3.17"]
    %% F4-03 职责／图形：人工／阅卷管理
    %% 说明及输入输出：按试题／考生／试卷组织；一对一、双判、多对一及一判／双判／多判；保密阅卷可选择并屏蔽身份
    F4_03["F4-03<br/>设置阅卷维度、判分方式及保密阅卷模式<br/>职责：人工／阅卷管理<br/>依据：2.3.5、2.3.16—17"]
    %% F4-04 职责／图形：人工／阅卷管理
    %% 说明及输入输出：权重评分、平均分、去极值平均分等；权重、人数、去极值规则及精度待确认
    F4_04["F4-04<br/>设置核分规则<br/>职责：人工／阅卷管理<br/>依据：2.3.15"]
    %% F4-05 职责／图形：人工／阅卷管理
    %% 说明及输入输出：两种配置粒度均保留；同时设置时的优先级待确认，不擅自规定覆盖关系
    F4_05["F4-05<br/>按试卷或试题设置评分差值阈值<br/>职责：人工／阅卷管理<br/>依据：2.3.14"]
    %% F4-06 职责／图形：人工／阅卷管理
    %% 说明及输入输出：不能用单一全局仲裁员替代按题配置；人员范围、数量及多人仲裁方式待确认
    F4_06["F4-06<br/>按试题设置仲裁人员及人数<br/>职责：人工／阅卷管理<br/>依据：2.3.14"]
    %% F4-07 职责／图形：人工／阅卷管理及系统
    %% 说明及输入输出：支持随机分配、小组配置、组员调整、重新分配；适用时点及已评分任务处理规则待确认
    F4_07["F4-07<br/>选择专家人数并分配阅卷任务与评分组<br/>职责：人工／阅卷管理及系统<br/>依据：2.3.17"]
  end
  subgraph F4_LANE_2["阅卷专家／评分人员"]
    direction TB
    %% F4-09 职责／图形：人工／阅卷专家
    %% 说明及输入输出：一对一、双判、多对一等方式按配置展开；是否互相可见评分待确认
    F4_09["F4-09<br/>按评分标准完成线上评阅并提交评分<br/>职责：人工／阅卷专家<br/>依据：2.3.5、2.3.17"]
    %% F4-11 职责／图形：人工／阅卷专家
    %% 说明及输入输出：签字与题目／答卷／批次的关联粒度、签字技术形式待确认
    F4_11["F4-11<br/>判分完成后电子签字留痕<br/>职责：人工／阅卷专家<br/>依据：2.3.19"]
  end
  subgraph F4_LANE_3["按试题配置的仲裁人员"]
    direction TB
    %% F4-15 职责／图形：人工／仲裁人员
    %% 说明及输入输出：【编排】执行仲裁所需上下文；具体可见材料和字段待确认
    F4_15["F4-15<br/>查看争议评分及相关评阅材料<br/>职责：人工／仲裁人员<br/>依据：2.3.14"]
    %% F4-D4 职责／图形：判断／仲裁人员
    %% 说明及输入输出：【编排】协议明确两种操作能力，实际选择权限及条件待确认
    F4_D4{"F4-D4<br/>采用退回处置还是直接仲裁？<br/>职责：判断／仲裁人员<br/>依据：2.3.14"}
    %% F4-17 职责／图形：人工／仲裁人员
    %% 说明及输入输出：多人仲裁的定分方式、原评分如何保留、是否仍采用原核分规则待确认
    F4_17["F4-17<br/>直接仲裁并形成处理结果<br/>职责：人工／仲裁人员<br/>依据：2.3.14"]
    %% F4-16 职责／图形：人工／仲裁人员及阅卷管理
    %% 说明及输入输出：退给原评阅人还是新人员、影响哪些评分、从何节点重启待确认
    F4_16["F4-16<br/>退回处置并按确认规则重新组织评阅<br/>职责：人工／仲裁人员及阅卷管理<br/>依据：2.3.14、2.3.17"]
  end
  subgraph F4_LANE_4["成绩／归档使用者及考生"]
    direction TB
    %% F4-20 职责／图形：系统／考生
    %% 说明及输入输出：包含题型、知识结构得分分布及知识掌握情况；回到F3的成绩查看连接点
    F4_20["F4-20<br/>形成并提供个人成绩与分析报告<br/>职责：系统／考生<br/>依据：2.3.13"]
    %% F4-21 职责／图形：系统／获授权人员
    %% 说明及输入输出：文件组成、权限与保存期限待确认，不据此新增归档审批
    F4_21["F4-21<br/>归档无纸化考试数据并支持下载<br/>职责：系统／获授权人员<br/>依据：2.3.20"]
  end
  subgraph F4_LANE_5["集团认定系统"]
    direction TB
    %% F4-22 职责／图形：系统／集团认定系统
    %% 说明及输入输出：确保数据传输准确性；触发时点、接口映射、结果更新方式待确认
    F4_22["F4-22<br/>自动回传客观分、主观核分结果及总成绩<br/>职责：系统／集团认定系统<br/>依据：2.4.6"]
  end
  subgraph F4_LINKS["跨流程交接／协议未明确的路径出口"]
    F3_19(["F3-19<br/>提供可获取的成绩及个人分析报告"])
