flowchart TB
  %% F6 电子书资源上传、发布、阅读与维护
  %% 实线：业务衔接；虚线：待确认路径；角色分组不等同于固定岗位或已确认权限。
  subgraph F6_LANE_0["正版资源提供方"]
    direction TB
    %% F6-S 职责／图形：开始／资源提供方
    %% 说明及输入输出：不少于500本；资源交付要求，不等于每本图书必须经过新增线上采购审批
    F6_S(["F6-S<br/>提供中文优质正版数字图书资源<br/>职责：开始／资源提供方<br/>依据：2.2.18"])
  end
  subgraph F6_LANE_1["电子书管理员"]
    direction TB
    %% F6-01 职责／图形：人工／管理员
    %% 说明及输入输出：种类包含航空航天、智能制造、工业技术、人文、社科、人力资源等
    F6_01["F6-01<br/>按图书类型选择并上传电子书文件<br/>职责：人工／管理员<br/>依据：2.2.17—18"]
    %% F6-03 职责／图形：人工／管理员
    %% 说明及输入输出：发布后用户即可查看学习；不附加未经约定的多级审核
    F6_03["F6-03<br/>发布上传完成的电子书<br/>职责：人工／管理员<br/>依据：2.2.17"]
    %% F6-06 职责／图形：人工／管理员
    %% 说明及输入输出：可维护哪些信息、是否允许替换正文及是否重新发布待确认
    F6_06["F6-06<br/>维护电子书资源<br/>职责：人工／管理员<br/>依据：2.2.17"]
    %% F6-D1 职责／图形：判断／管理员
    %% 说明及输入输出：【编排】两种处置能力；不默认“必须先下架才可删除”
    F6_D1{"F6-D1<br/>是否需要下架或删除废弃电子书？<br/>职责：判断／管理员<br/>依据：2.2.17"}
    %% F6-07 职责／图形：人工／管理员及系统
    %% 说明及输入输出：下架后的可见性和恢复发布规则待确认
    F6_07["F6-07<br/>下架不再提供使用的电子书<br/>职责：人工／管理员及系统<br/>依据：2.2.17"]
    %% F6-08 职责／图形：人工／管理员及系统
    %% 说明及输入输出：日志保留是明确要求；逻辑删除还是物理删除、正文保存期限待确认
    F6_08["F6-08<br/>删除废弃电子书并保留操作日志<br/>职责：人工／管理员及系统<br/>依据：2.2.17"]
  end
  subgraph F6_LANE_2["获准阅读用户"]
    direction TB
    %% F6-05 职责／图形：人工／用户
    %% 说明及输入输出：这是阅读使用节点，不自动生成学习任务或考核
    F6_05["F6-05<br/>查看电子书并学习<br/>职责：人工／用户<br/>依据：2.2.17"]
    %% F6-E 职责／图形：结束／持续服务
    %% 说明及输入输出：【编排】资源持续管理，不要求阅读结束后走管理员审批
    F6_E(["F6-E<br/>已发布资源供用户学习，维护操作可追溯<br/>职责：结束／持续服务<br/>依据：2.2.17"])
  end
  subgraph F6_LANE_3["系统自动处理"]
    direction TB
    %% F6-02 职责／图形：系统
    %% 说明及输入输出：【编排】用于实现上传、发布和维护；文件格式、大小和元数据范围待确认
    F6_02["F6-02<br/>接收并保存上传的电子书资源<br/>职责：系统<br/>依据：2.2.17"]
    %% F6-04 职责／图形：系统
    %% 说明及输入输出：用户范围及权限待确认；协议未明确全文检索、下载或离线阅读功能
    F6_04["F6-04<br/>向用户提供已发布电子书查看入口<br/>职责：系统<br/>依据：2.2.17"]
    %% F6-09 职责／图形：系统／获授权人员
    %% 说明及输入输出：上传、发布、维护、下架和删除关联对象可追溯；详细字段与期限待确认
    F6_09["F6-09<br/>记录并追溯资源管理操作<br/>职责：系统／获授权人员<br/>依据：2.2.17"]
  end
  subgraph F6_LINKS["跨流程交接／协议未明确的路径出口"]
    F6_R上传异常(["F6-R上传异常<br/>处理方式或返回节点待确认"])
  end
